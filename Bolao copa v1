<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bolão Copa do Mundo 2026</title>
<style>
  :root {
    --verde: #0a7c3e;
    --verde-claro: #1db954;
    --amarelo: #f5c518;
    --azul: #003580;
    --cinza: #f0f2f5;
    --branco: #ffffff;
    --texto: #1a1a2e;
    --borda: #dde1e7;
    --sombra: 0 2px 12px rgba(0,0,0,0.10);
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Segoe UI', Arial, sans-serif;
    background: linear-gradient(135deg, #0a7c3e 0%, #003580 100%);
    min-height: 100vh; padding: 20px; color: var(--texto);
  }
  .container { max-width: 900px; margin: 0 auto; }
  .header {
    text-align: center; padding: 32px 24px 24px;
    background: rgba(255,255,255,0.97);
    border-radius: 20px 20px 0 0;
    border-bottom: 4px solid var(--amarelo);
  }
  .header .trophy { font-size: 52px; margin-bottom: 8px; }
  .header h1 { font-size: 1.9rem; color: var(--verde); font-weight: 800; letter-spacing: 1px; }
  .header p { color: #555; font-size: 0.95rem; margin-top: 6px; }
  .participante-box { background: var(--branco); padding: 20px 28px; border-bottom: 1px solid var(--borda); }
  .participante-box h3 { font-size: 1rem; color: var(--verde); margin-bottom: 10px; font-weight: 700; }
  .input-row { display: flex; gap: 14px; flex-wrap: wrap; }
  .input-row input {
    flex: 1; min-width: 180px; padding: 10px 14px;
    border: 2px solid var(--borda); border-radius: 8px;
    font-size: 0.95rem; transition: border 0.2s; outline: none;
  }
  .input-row input:focus { border-color: var(--verde-claro); }
  .especial-box {
    background: linear-gradient(90deg, #fff8e1, #fffde7);
    border: 2px solid var(--amarelo); border-radius: 12px;
    margin: 18px 28px; padding: 18px 22px;
  }
  .especial-box h3 { font-size: 1rem; color: #7a5c00; margin-bottom: 14px; font-weight: 700; }
  .especial-row { display: flex; gap: 16px; flex-wrap: wrap; }
  .especial-item {
    flex: 1; min-width: 200px; background: var(--branco);
    border-radius: 10px; padding: 12px 16px; border: 1.5px solid var(--amarelo);
  }
  .especial-item label { font-size: 0.85rem; font-weight: 700; color: #7a5c00; display: block; margin-bottom: 6px; }
  .pts-badge { background: var(--amarelo); color: #7a5c00; border-radius: 20px; font-size: 0.75rem; font-weight: 700; padding: 2px 8px; margin-left: 6px; }
  .pts-badge-red { background: #e74c3c; color: #fff; border-radius: 20px; font-size: 0.75rem; font-weight: 700; padding: 2px 8px; margin-left: 6px; }
  .especial-item input { width: 100%; padding: 8px 12px; border: 1.5px solid var(--borda); border-radius: 7px; font-size: 0.9rem; outline: none; transition: border 0.2s; }
  .especial-item input:focus { border-color: var(--amarelo); }
  .pontuacao-box { margin: 0 28px 18px; background: #f8faff; border: 1.5px solid #c8d6f0; border-radius: 12px; padding: 14px 20px; cursor: pointer; }
  .pontuacao-toggle { display: flex; align-items: center; justify-content: space-between; font-weight: 700; color: var(--azul); font-size: 0.95rem; user-select: none; }
  .pontuacao-content { display: none; margin-top: 12px; }
  .pontuacao-content.open { display: block; }
  .pts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 8px; margin-top: 8px; }
  .pts-item { background: var(--branco); border-radius: 8px; padding: 8px 12px; font-size: 0.82rem; border-left: 3px solid var(--verde-claro); color: var(--texto); }
  .pts-item strong { color: var(--verde); font-size: 1rem; }
  .fase-section { background: var(--branco); padding: 0 0 10px; }
  .fase-header { background: var(--verde); color: var(--branco); padding: 12px 28px; font-size: 1rem; font-weight: 800; letter-spacing: 0.5px; display: flex; align-items: center; gap: 8px; margin-top: 4px; }
  .grupo-section { padding: 8px 28px 4px; }
  .grupo-title { font-size: 0.85rem; font-weight: 800; color: var(--azul); text-transform: uppercase; letter-spacing: 1px; padding: 8px 0 6px; border-bottom: 2px solid var(--cinza); margin-bottom: 8px; }
  .jogo-card { display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-radius: 10px; margin-bottom: 7px; background: var(--cinza); flex-wrap: wrap; transition: background 0.2s; }
  .jogo-card:hover { background: #e4edf5; }
  .jogo-info { flex: 1; min-width: 200px; }
  .jogo-data { font-size: 0.72rem; color: #888; margin-bottom: 2px; }
  .jogo-times { font-size: 0.92rem; font-weight: 700; color: var(--texto); }
  .jogo-local { font-size: 0.72rem; color: #999; margin-top: 1px; }
  .placar-input { display: flex; align-items: center; gap: 6px; }
  .placar-input input[type="number"] { width: 46px; height: 38px; text-align: center; font-size: 1.1rem; font-weight: 700; border: 2px solid var(--borda); border-radius: 8px; outline: none; background: var(--branco); transition: border 0.2s; -moz-appearance: textfield; }
  .placar-input input[type="number"]::-webkit-outer-spin-button,
  .placar-input input[type="number"]::-webkit-inner-spin-button { -webkit-appearance: none; }
  .placar-input input[type="number"]:focus { border-color: var(--verde-claro); }
  .placar-sep { font-size: 1.3rem; font-weight: 900; color: #aaa; }
  .pen-toggle { display: flex; align-items: center; gap: 5px; font-size: 0.78rem; color: #666; white-space: nowrap; }
  .pen-toggle input[type="checkbox"] { cursor: pointer; width: 14px; height: 14px; }
  .pen-select { display: none; margin-top: 4px; width: 100%; }
  .pen-select select { width: 100%; padding: 6px 8px; border: 1.5px solid var(--amarelo); border-radius: 7px; font-size: 0.82rem; outline: none; background: #fffde7; color: var(--texto); }
  .pen-select.show { display: block; }
  .fase-header.mata { background: var(--azul); }
  .fase-header.semi { background: #6a0dad; }
  .fase-header.final { background: #b8860b; }
  .btn-submit { display: block; width: calc(100% - 56px); margin: 18px 28px 28px; padding: 16px; background: linear-gradient(90deg, var(--verde), var(--verde-claro)); color: var(--branco); font-size: 1.1rem; font-weight: 800; border: none; border-radius: 12px; cursor: pointer; letter-spacing: 1px; box-shadow: var(--sombra); transition: transform 0.15s, box-shadow 0.15s; }
  .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,0.18); }
  .btn-submit:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
  .modal-overlay { display: none; position: fixed; top:0; left:0; right:0; bottom:0; background: rgba(0,0,0,0.6); z-index: 9999; align-items: center; justify-content: center; }
  .modal-overlay.show { display: flex; }
  .modal-box { background: var(--branco); border-radius: 18px; padding: 32px 28px; max-width: 460px; width: 92%; text-align: center; box-shadow: 0 8px 40px rgba(0,0,0,0.25); position: relative; }
  .modal-box h2 { color: var(--verde); font-size: 1.5rem; margin-bottom: 8px; }
  .modal-box p { color: #555; font-size: 0.95rem; margin-bottom: 16px; }
  .modal-close { position: absolute; top:12px; right:16px; font-size:1.4rem; cursor:pointer; color:#aaa; }
  .modal-close:hover { color: #333; }
  .modal-btn { background: var(--verde); color: var(--branco); border: none; border-radius: 8px; padding: 10px 28px; font-size: 1rem; font-weight: 700; cursor: pointer; margin-top: 4px; }
  .modal-btn:hover { background: var(--verde-claro); }
  .summary-list { text-align: left; max-height: 280px; overflow-y: auto; margin: 10px 0 16px; font-size: 0.82rem; border: 1px solid var(--borda); border-radius: 8px; padding: 10px; }
  .summary-list .s-item { padding: 4px 0; border-bottom: 1px solid #f0f0f0; display: flex; justify-content: space-between; }
  .summary-list .s-item:last-child { border-bottom: none; }
  .spinner { display: inline-block; width: 18px; height: 18px; border: 3px solid rgba(255,255,255,0.4); border-top-color: #fff; border-radius: 50%; animation: spin 0.7s linear infinite; vertical-align: middle; margin-right: 8px; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .toast { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%); background: #222; color: #fff; padding: 12px 24px; border-radius: 30px; font-size: 0.9rem; z-index: 99999; opacity: 0; transition: opacity 0.3s; pointer-events: none; white-space: nowrap; }
  .toast.show { opacity: 1; }
  .toast.success { background: var(--verde); }
  .toast.error { background: #c0392b; }
  .tag-fase { font-size: 0.68rem; background: rgba(255,255,255,0.25); border-radius: 6px; padding: 2px 8px; font-weight: 600; }
  .counter-bar { background: rgba(255,255,255,0.97); padding: 8px 28px; font-size: 0.82rem; color: #555; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--borda); }
  .counter-bar span strong { color: var(--verde); }
  @media (max-width: 600px) {
    .header h1 { font-size: 1.3rem; }
    .grupo-section { padding: 8px 12px 4px; }
    .btn-submit { width: calc(100% - 24px); margin: 18px 12px 28px; }
    .fase-header { padding: 12px 14px; }
    .jogo-card { padding: 8px 10px; }
    .especial-box, .pontuacao-box { margin: 14px 12px; }
    .participante-box { padding: 16px 12px; }
  }
</style>
</head>
<body>
<div class="container">

  <div class="header">
    <div class="trophy">🏆</div>
    <h1>BOLÃO COPA DO MUNDO 2026</h1>
    <p>EUA · México · Canadá &nbsp;|&nbsp; 11 de junho – 19 de julho de 2026 &nbsp;|&nbsp; 104 jogos</p>
  </div>

  <div class="participante-box">
    <h3>👤 Dados do Participante</h3>
    <div class="input-row">
      <input type="text" id="nome" placeholder="Seu nome completo" required>
      <input type="text" id="apelido" placeholder="Apelido (opcional)">
    </div>
  </div>

  <div class="especial-box">
    <h3>🌟 Aposta Especial Pré-Copa</h3>
    <div class="especial-row">
      <div class="especial-item">
        <label>🏆 Campeão <span class="pts-badge">+15 pts</span></label>
        <input type="text" id="campeao" placeholder="Ex: Brasil">
      </div>
      <div class="especial-item">
        <label>🥈 Vice-Campeão <span class="pts-badge">+5 pts</span></label>
        <input type="text" id="vice" placeholder="Ex: Argentina">
      </div>
      <div class="especial-item">
        <label>⚽ Artilheiro <span class="pts-badge-red">+7 pts</span></label>
        <input type="text" id="artilheiro" placeholder="Ex: Vinicius Jr.">
      </div>
    </div>
  </div>

  <div class="pontuacao-box" onclick="togglePontuacao()">
    <div class="pontuacao-toggle">
      <span>⚽ Ver Regras de Pontuação</span>
      <span id="arrow">▼</span>
    </div>
    <div class="pontuacao-content" id="pontuacaoContent">
      <div class="pts-grid">
        <div class="pts-item"><strong>6 pts</strong> — Placar exato</div>
        <div class="pts-item"><strong>4 pts</strong> — Vencedor + gols de 1 time</div>
        <div class="pts-item"><strong>3 pts</strong> — Apenas o vencedor ou empate sem exato</div>
        <div class="pts-item"><strong>1 pt</strong> — Gols de 1 time sem acertar vencedor</div>
        <div class="pts-item"><strong>9 pts</strong> — Empate exato + pênaltis correto</div>
        <div class="pts-item"><strong>6 pts</strong> — Empate exato + pênaltis errado</div>
        <div class="pts-item"><strong>6 pts</strong> — Empate sem exato + pênaltis correto</div>
        <div class="pts-item"><strong>3 pts</strong> — Empate sem exato + pênaltis errado</div>
        <div class="pts-item"><strong>15 pts</strong> — Acertar o Campeão</div>
        <div class="pts-item"><strong>5 pts</strong> — Acertar o Vice</div>
        <div class="pts-item" style="border-left-color:#e74c3c;"><strong style="color:#e74c3c;">7 pts</strong> — Acertar o Artilheiro</div>
      </div>
    </div>
  </div>

  <div class="counter-bar">
    <span>Jogos preenchidos: <strong id="preenchidos">0</strong> / 104</span>
    <span>Grupos: 72 &nbsp;|&nbsp; Mata-mata: 32</span>
  </div>

  <div class="fase-section" id="formJogos">

    <div class="fase-header">⚽ FASE DE GRUPOS <span class="tag-fase">72 jogos • 11 Jun – 27 Jun</span></div>

    <div class="grupo-section">
      <div class="grupo-title">Grupo A — México · África do Sul · Coreia do Sul · Rep. Tcheca</div>
      <div class="jogo-card" data-id="1"><div class="jogo-info"><div class="jogo-data">Qui 11/06 • 16h</div><div class="jogo-times">🇲🇽 México vs África do Sul 🇿🇦</div><div class="jogo-local">📍 Cidade do México</div></div><div class="placar-input"><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"><span class="placar-sep">×</span><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"></div></div>
      <div class="jogo-card" data-id="2"><div class="jogo-info"><div class="jogo-data">Qui 11/06 • 23h</div><div class="jogo-times">🇰🇷 Coreia do Sul vs Rep. Tcheca 🇨🇿</div><div class="jogo-local">📍 Guadalajara</div></div><div class="placar-input"><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"><span class="placar-sep">×</span><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"></div></div>
      <div class="jogo-card" data-id="3"><div class="jogo-info"><div class="jogo-data">Qui 18/06 • 13h</div><div class="jogo-times">🇨🇿 Rep. Tcheca vs África do Sul 🇿🇦</div><div class="jogo-local">📍 Atlanta</div></div><div class="placar-input"><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"><span class="placar-sep">×</span><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"></div></div>
      <div class="jogo-card" data-id="4"><div class="jogo-info"><div class="jogo-data">Qui 18/06 • 22h</div><div class="jogo-times">🇲🇽 México vs Coreia do Sul 🇰🇷</div><div class="jogo-local">📍 Guadalajara</div></div><div class="placar-input"><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"><span class="placar-sep">×</span><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"></div></div>
      <div class="jogo-card" data-id="5"><div class="jogo-info"><div class="jogo-data">Qua 24/06 • 22h</div><div class="jogo-times">🇨🇿 Rep. Tcheca vs México 🇲🇽</div><div class="jogo-local">📍 Cidade do México</div></div><div class="placar-input"><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"><span class="placar-sep">×</span><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"></div></div>
      <div class="jogo-card" data-id="6"><div class="jogo-info"><div class="jogo-data">Qua 24/06 • 22h</div><div class="jogo-times">🇿🇦 África do Sul vs Coreia do Sul 🇰🇷</div><div class="jogo-local">📍 Monterrey</div></div><div class="placar-input"><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"><span class="placar-sep">×</span><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"></div></div>
    </div>

    <div class="grupo-section">
      <div class="grupo-title">Grupo B — Canadá · Bósnia-Herzegovina · Catar · Suíça</div>
      <div class="jogo-card" data-id="7"><div class="jogo-info"><div class="jogo-data">Sex 12/06 • 16h</div><div class="jogo-times">🇨🇦 Canadá vs Bósnia-Herzegovina 🇧🇦</div><div class="jogo-local">📍 Toronto</div></div><div class="placar-input"><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"><span class="placar-sep">×</span><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"></div></div>
      <div class="jogo-card" data-id="8"><div class="jogo-info"><div class="jogo-data">Sáb 13/06 • 16h</div><div class="jogo-times">🇶🇦 Catar vs Suíça 🇨🇭</div><div class="jogo-local">📍 San Francisco</div></div><div class="placar-input"><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"><span class="placar-sep">×</span><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"></div></div>
      <div class="jogo-card" data-id="9"><div class="jogo-info"><div class="jogo-data">Qui 18/06 • 16h</div><div class="jogo-times">🇨🇭 Suíça vs Bósnia-Herzegovina 🇧🇦</div><div class="jogo-local">📍 Los Angeles</div></div><div class="placar-input"><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"><span class="placar-sep">×</span><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"></div></div>
      <div class="jogo-card" data-id="10"><div class="jogo-info"><div class="jogo-data">Qui 18/06 • 19h</div><div class="jogo-times">🇨🇦 Canadá vs Catar 🇶🇦</div><div class="jogo-local">📍 Vancouver</div></div><div class="placar-input"><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"><span class="placar-sep">×</span><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"></div></div>
      <div class="jogo-card" data-id="11"><div class="jogo-info"><div class="jogo-data">Qua 24/06 • 16h</div><div class="jogo-times">🇨🇭 Suíça vs Canadá 🇨🇦</div><div class="jogo-local">📍 Vancouver</div></div><div class="placar-input"><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"><span class="placar-sep">×</span><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"></div></div>
      <div class="jogo-card" data-id="12"><div class="jogo-info"><div class="jogo-data">Qua 24/06 • 16h</div><div class="jogo-times">🇧🇦 Bósnia-Herzegovina vs Catar 🇶🇦</div><div class="jogo-local">📍 Seattle</div></div><div class="placar-input"><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"><span class="placar-sep">×</span><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"></div></div>
    </div>

    <div class="grupo-section">
      <div class="grupo-title">Grupo C — Brasil · Marrocos · Escócia · Haiti</div>
      <div class="jogo-card" data-id="13"><div class="jogo-info"><div class="jogo-data">Sáb 13/06 • 19h</div><div class="jogo-times">🇧🇷 Brasil vs Marrocos 🇲🇦</div><div class="jogo-local">📍 Nova York</div></div><div class="placar-input"><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"><span class="placar-sep">×</span><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"></div></div>
      <div class="jogo-card" data-id="14"><div class="jogo-info"><div class="jogo-data">Sáb 13/06 • 22h</div><div class="jogo-times">🇭🇹 Haiti vs Escócia 🏴󠁧󠁢󠁳󠁣󠁴󠁿</div><div class="jogo-local">📍 Boston</div></div><div class="placar-input"><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"><span class="placar-sep">×</span><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"></div></div>
