      <div class="jogo-card" data-id="17"><div class="jogo-info"><div class="jogo-data">Qua 24/06 • 19h</div><div class="jogo-times">🏴󠁧󠁢󠁳󠁣󠁴󠁿 Escócia vs Brasil 🇧🇷</div><div class="jogo-local">📍 Miami</div></div><div class="placar-input"><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"><span class="placar-sep">×</span><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"></div></div>
      <div class="jogo-card" data-id="18"><div class="jogo-info"><div class="jogo-data">Qua 24/06 • 19h</div><div class="jogo-times">🇲🇦 Marrocos vs Haiti 🇭🇹</div><div class="jogo-local">📍 Atlanta</div></div><div class="placar-input"><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"><span class="placar-sep">×</span><input type="number" min="0" max="99" placeholder="0" oninput="updateCount()"></div></div>
    </div>

