<div class="modal-overlay" id="modalOverlay">
  <div class="modal-box">
    <span class="modal-close" onclick="fecharModal()">✕</span>
    <h2>🎉 Palpites Enviados!</h2>
    <p id="modalNome"></p>
    <div class="summary-list" id="summaryList"></div>
    <button class="modal-btn" onclick="fecharModal()">Fechar</button>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
  // ⚙️ COLE SUA URL AQUI
  const APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbyw5ZJqtJ_4FzhBqYrzapU79oCPuSCBP9wyTIlRIypB2TZm5Q7ZkECXHMBMJ4xUnh235A/exec";

  // Gera jogos do mata-mata dinamicamente
  function gerarJogosMata(containerId, jogos) {
    const container = document.getElementById(containerId);
    if (!container) return;
    container.innerHTML = jogos.map(j => `
      <div class="jogo-card" data-id="${j.id}">
        <div class="jogo-info">
          <div class="jogo-data">${j.data}</div>
          <div class="jogo-times">Jogo ${j.id} — A definir vs A definir</div>
          <div class="jogo-local">📍 ${j.local}</div>
        </div>
        <div style="width:100%">
          <div class="placar-input">
            <input type="number" min="0" max="99" placeholder="0" oninput="updateCount()">
            <span class="placar-sep">×</span>
            <input type="number" min="0" max="99" placeholder="0" oninput="updateCount()">
          </div>
          <div class="pen-toggle" style="margin-top:6px">
            <input type="checkbox" onchange="togglePen(this,${j.id})"> Houve pênaltis?
          </div>
          <div class="pen-select" id="pen-${j.id}">
            <select><option value="">— Quem avançou? —</option><option value="time1">Time 1 (esquerda)</option><option value="time2">Time 2 (direita)</option></select>
          </div>
        </div>
      </div>`).join('');
  }

  const r32 = [
    {id:73,data:'Dom 28/06 • 16h',local:'Los Angeles'},{id:74,data:'Seg 29/06 • 17h30',local:'Boston'},
    {id:75,data:'Seg 29/06 • 22h',local:'Monterrey'},{id:76,data:'Seg 29/06 • 14h',local:'Houston'},
    {id:77,data:'Ter 30/06 • 18h',local:'Nova York'},{id:78,data:'Ter 30/06 • 14h',local:'Dallas'},
    {id:79,data:'Ter 30/06 • 22h',local:'Cidade do México'},{id:80,data:'Qua 01/07 • 13h',local:'Atlanta'},
    {id:81,data:'Qua 01/07 • 21h',local:'San Francisco'},{id:82,data:'Qua 01/07 • 17h',local:'Seattle'},
    {id:83,data:'Qui 02/07 • 20h',local:'Toronto'},{id:84,data:'Qui 02/07 • 16h',local:'Los Angeles'},
    {id:85,data:'Qui 02/07 • 00h',local:'Vancouver'},{id:86,data:'Sex 03/07 • 19h',local:'Miami'},
    {id:87,data:'Sex 03/07 • 22h30',local:'Kansas City'},{id:88,data:'Sex 03/07 • 15h',local:'Dallas'}
  ];
  const oitavas = [
    {id:89,data:'Sáb 04/07 • 18h',local:'Filadélfia'},{id:90,data:'Sáb 04/07 • 14h',local:'Houston'},
    {id:91,data:'Dom 05/07 • 17h',local:'Nova York'},{id:92,data:'Dom 05/07 • 21h',local:'Cidade do México'},
    {id:93,data:'Seg 06/07 • 16h',local:'Dallas'},{id:94,data:'Seg 06/07 • 21h',local:'Seattle'},
    {id:95,data:'Ter 07/07 • 13h',local:'Atlanta'},{id:96,data:'Ter 07/07 • 17h',local:'Vancouver'}
  ];
  const quartas = [
    {id:97,data:'Qui 09/07 • 17h',local:'Boston'},{id:98,data:'Sex 10/07 • 16h',local:'Los Angeles'},
    {id:99,data:'Sáb 11/07 • 18h',local:'Miami'},{id:100,data:'Sáb 11/07 • 22h',local:'Kansas City'}
  ];
  const semis = [
    {id:101,data:'Ter 14/07 • 16h',local:'Dallas'},{id:102,data:'Qua 15/07 • 16h',local:'Atlanta'}
  ];

  gerarJogosMata('r32-jogos', r32);
  gerarJogosMata('oitavas-jogos', oitavas);
  gerarJogosMata('quartas-jogos', quartas);
  gerarJogosMata('semi-jogos', semis);

  function togglePontuacao() {
    const c = document.getElementById('pontuacaoContent');
    const a = document.getElementById('arrow');
    c.classList.toggle('open');
    a.textContent = c.classList.contains('open') ? '▲' : '▼';
  }

  function togglePen(cb, id) {
    const el = document.getElementById('pen-' + id);
    if (el) el.classList.toggle('show', cb.checked);
  }

  function updateCount() {
    let count = 0;
    document.querySelectorAll('.jogo-card').forEach(card => {
      const inputs = card.querySelectorAll('input[type="number"]');
      if (inputs.length >= 2 && inputs[0].value !== '' && inputs[1].value !== '') count++;
    });
    document.getElementById('preenchidos').textContent = count;
  }

  function showToast(msg, tipo = '') {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.className = 'toast show ' + tipo;
    setTimeout(() => { t.className = 'toast'; }, 3500);
  }

  async function enviarBolao() {
    const nome = document.getElementById('nome').value.trim();
    if (!nome) { showToast('⚠️ Informe seu nome antes de confirmar!', 'error'); return; }
    if (APPS_SCRIPT_URL === "COLE_SUA_URL_AQUI") { showToast('⚠️ URL do Apps Script não configurada!', 'error'); return; }

    const jogos = {};
    const resumo = [];
    let totalPreenchidos = 0;

    document.querySelectorAll('.jogo-card').forEach(card => {
      const id = parseInt(card.getAttribute('data-id'));
      const inputs = card.querySelectorAll('input[type="number"]');
      const times = card.querySelector('.jogo-times');
      if (inputs.length >= 2) {
        const casa = inputs[0].value !== '' ? parseInt(inputs[0].value) : '';
        const fora = inputs[1].value !== '' ? parseInt(inputs[1].value) : '';
        const penDiv = document.getElementById('pen-' + id);
        let pen = '';
        if (penDiv && penDiv.classList.contains('show')) {
          const sel = penDiv.querySelector('select');
          pen = sel ? sel.value : '';
        }
        jogos[id] = { casa, fora, pen };
        if (casa !== '' && fora !== '') {
          totalPreenchidos++;
          resumo.push({ label: times ? times.textContent.trim() : `Jogo ${id}`, placar: `${casa} × ${fora}${pen ? ` (Pên: ${pen === 'time1' ? 'T1' : 'T2'})` : ''}` });
        }
      }
    });

    const payload = {
      nome,
      apelido: document.getElementById('apelido').value.trim(),
      campeao: document.getElementById('campeao').value.trim(),
      vice: document.getElementById('vice').value.trim(),
      artilheiro: document.getElementById('artilheiro').value.trim(),
      jogos
    };

    const btn = document.getElementById('btnEnviar');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner"></span>Enviando...';

    try {
      const resp = await fetch(APPS_SCRIPT_URL, { method: 'POST', body: JSON.stringify(payload) });
      const json = await resp.json();
      if (json.status === 'ok') {
        document.getElementById('modalNome').innerHTML =
          `<strong>${nome}</strong> | 🏆 ${payload.campeao||'—'} | 🥈 ${payload.vice||'—'} | ⚽ ${payload.artilheiro||'—'}<br>
          <span style="font-size:0.82rem;color:#888;">Jogos preenchidos: ${totalPreenchidos}/104</span>`;
        document.getElementById('summaryList').innerHTML = resumo.length
          ? resumo.map(i => `<div class="s-item"><span>${i.label}</span><strong>${i.placar}</strong></div>`).join('')
          : '<div style="color:#aaa;padding:8px;">Nenhum palpite preenchido.</div>';
        document.getElementById('modalOverlay').classList.add('show');
        showToast('✅ Palpites salvos com sucesso!', 'success');
      } else { throw new Error(json.msg || 'Erro desconhecido'); }
    } catch (err) {
      showToast('❌ Erro ao enviar. Tente novamente.', 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = '✅ CONFIRMAR MEUS PALPITES';
    }
  }

  function fecharModal() { document.getElementById('modalOverlay').classList.remove('show'); }
  document.getElementById('modalOverlay').addEventListener('click', function(e) { if (e.target === this) fecharModal(); });
</script>
